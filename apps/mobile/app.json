{
  "expo": {
    "name": "Kittu Cafe",
    "slug": "kittu-cafe",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "kittucafe",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#FAF6F0",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kittucafe.customer"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#231709"
      },
      "package": "com.kittucafe.customer",
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router"
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "3a5c1d46-a53a-4467-801b-b1da4c011acc"
      }
    },
    "owner": "bhsoft"
  }
}
