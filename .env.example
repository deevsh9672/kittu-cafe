# ==============================================================================
# Kittu Cafe Platform - Environment Variables
# Location: Shiv Colony, Mariyara Wale, Dausa, Rajasthan 303303
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:3000,http://localhost:8081,http://localhost:19006

# MongoDB Database (Store prices in paise minor-units)
MONGODB_URI=mongodb://localhost:27017/kittu_cafe

# Redis Cache and Rate Limiting (Optional in dev - in-memory fallback enabled)
REDIS_URL=redis://localhost:6379

# JWT Authentication
JWT_SECRET=kittu_cafe_production_super_secret_jwt_key_dausa_2026_change_in_prod
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=kittu_cafe_refresh_secret_key_dausa_2026
JWT_REFRESH_EXPIRES_IN=30d

# Razorpay Payment Gateway (Indian Online Payments)
# Use test mode keys from https://dashboard.razorpay.com for development
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=placeholder_secret_key
RAZORPAY_WEBHOOK_SECRET=placeholder_webhook_secret

# Restaurant Initial Configuration (Overrides default database values if specified)
RESTAURANT_NAME="Kittu Cafe"
RESTAURANT_ADDRESS="W82P+3P7, Shiv Colony, Mariyara Wale, Dausa, Rajasthan 303303"
RESTAURANT_PHONE="+91 95113 17456"
CURRENCY=INR
TIMEZONE=Asia/Kolkata

# Notifications / SMS OTP (Mock mode enabled by default for local development)
MOCK_SMS_OTP=true
SMS_OTP_DEFAULT=123456

# Superadmin Initial Credentials for Seed Script
SEED_ADMIN_EMAIL=admin@kittucafe.in
SEED_ADMIN_PASSWORD=KittuAdmin@2026
SEED_ADMIN_PHONE=+919511317456
